# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback

# Path to service account JSON key file (for Drive/Sheets access)
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Google Sheet ID containing allowed emails in column A
ALLOWLIST_SHEET_ID=your_sheet_id

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_key

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your_secret_key

# Google Drive folder IDs to index (comma-separated)
DRIVE_FOLDER_IDS=0AAgHqsxVlMegUk9PVA,18k12A-Sm3DcluJ3OXl1o0Z-GmvWsOnnL
